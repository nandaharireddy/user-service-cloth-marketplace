# ============================================================
# User Service Environment Variables
# ============================================================

# Service Port
PORT=8081

# Eureka Discovery Server URL
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/cloth_marketplace?currentSchema=user_service
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_SCHEMA=user_service

# JWT Authentication Configuration (HS256 requires min 256 bits / 32 characters)
JWT_SECRET=clothmarketplace-super-secret-jwt-key-must-be-at-least-256-bits-long-for-hs256-algorithm
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Rate Limiting (max attempts per minute per client IP for /auth/login and /auth/register)
AUTH_RATE_LIMIT_PER_MINUTE=10
